# Copia este archivo como .env en la carpeta de cada servicio y rellena los valores.
# Nunca subas el .env real al repositorio.

TZ=Europe/Madrid

# Umami
UMAMI_DB_PASSWORD=cambia-esto
UMAMI_APP_SECRET=genera-con-openssl-rand-hex-32

# n8n
N8N_HOST=n8n.tudominio.com
N8N_ENCRYPTION_KEY=genera-con-openssl-rand-hex-32

# Listmonk
LISTMONK_DB_PASSWORD=cambia-esto
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=cambia-esto

# Cloudflare Tunnel (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=pega-aqui-el-token

# Tailscale (Settings > Keys > Generate auth key)
TS_AUTHKEY=tskey-auth-xxxxx
